# ぷちたちを動かす部品の一覧。  vcs import src < petit.repos
# version はコミット(家で動いている版に固定、2026-10-12)。上げるときはここを書き換えて PR → マージ後に家で vcs import し直す。
# 開発中の部品を追いたいときは、その部品の clone で git switch する(ここは変えない)。
repositories:
  m5-petit-notes:
    type: git
    url: https://github.com/PetitOnes/m5-petit-notes.git
    version: 4d6bd6b43c708b82c4627c99531f9c693760602f
  m5-petit-relations:
    type: git
    url: https://github.com/PetitOnes/m5-petit-relations.git
    version: 986bc4796f371280811b17fdd206d15ed464278f
  m5-petit-desire:
    type: git
    url: https://github.com/PetitOnes/m5-petit-desire.git
    version: e456bb1c98731f3afcfae63ed879eb8974fa5352
  m5-petit-memory:
    type: git
    url: https://github.com/PetitOnes/m5-petit-memory.git
    version: 0c22703409ff55e02bb1af4779b8a4f6b1babd84
  m5-petit-mcp:
    type: git
    url: https://github.com/PetitOnes/m5-petit-mcp.git
    version: 6a251a9c7d1b76db6322f83267af624a8d24c03f
  m5-petit-app:
    type: git
    url: https://github.com/PetitOnes/m5-petit-app.git
    version: f385eae0d85f58b5f84877121f880bdea6e64324
  m5-petit-scripts:
    type: git
    url: https://github.com/PetitOnes/m5-petit-scripts.git
    version: cd3226b20567ec9e25e1000c1a09b0f3e60882ec
  m5-petit-switchbot:
    type: git
    url: https://github.com/PetitOnes/m5-petit-switchbot.git
    version: d30190aab0ebf548e61f51c149541db185eaf715
  # 声(TTS)と聞き取り(ASR)。GPU なしでも動く。別の PC に置く場合は、その PC でこの 2 つだけ取ればよい
  m5-petit-speech:
    type: git
    url: https://github.com/PetitOnes/m5-petit-speech.git
    version: 9a445777c5e40cd169656806284604bfa2850a9d
  m5-petit-voice-recognition:
    type: git
    url: https://github.com/PetitOnes/m5-petit-voice-recognition.git
    version: main
