# ぷちたちを動かす部品の一覧。  vcs import src < petit.repos
# version は main(開発中)。配るときはタグに固定する。
repositories:
  m5-petit-notes:
    type: git
    url: https://github.com/PetitOnes/m5-petit-notes.git
    version: main
  m5-petit-relations:
    type: git
    url: https://github.com/PetitOnes/m5-petit-relations.git
    version: main
  m5-petit-desire:
    type: git
    url: https://github.com/PetitOnes/m5-petit-desire.git
    version: main
  m5-petit-memory:
    type: git
    url: https://github.com/PetitOnes/m5-petit-memory.git
    version: main
  m5-petit-mcp:
    type: git
    url: https://github.com/PetitOnes/m5-petit-mcp.git
    version: develop
  m5-petit-app:
    type: git
    url: https://github.com/PetitOnes/m5-petit-app.git
    version: develop
  m5-petit-scripts:
    type: git
    url: https://github.com/PetitOnes/m5-petit-scripts.git
    version: main
  m5-petit-switchbot:
    type: git
    url: https://github.com/PetitOnes/m5-petit-switchbot.git
    version: main
  # 声(TTS)と聞き取り(ASR)。GPU なしでも動く。別の PC に置く場合は、その PC でこの 2 つだけ取ればよい
  m5-petit-speech:
    type: git
    url: https://github.com/PetitOnes/m5-petit-speech.git
    version: develop
  m5-petit-voice-recognition:
    type: git
    url: https://github.com/PetitOnes/m5-petit-voice-recognition.git
    version: main
