# 🧊 toio の番人(scripts/toio_server.py)。キューブとつながっているのはこれだけ(2026-11-18)
# 入れ方: cp scripts/petit-toio.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now petit-toio
[Unit]
Description=Petit toio keeper
After=bluetooth.target

[Service]
Type=simple
WorkingDirectory=%h/work/embodied-claude
# Bluetooth の部品 bleak は uv が用意する(PC の python3 には入っていないことがある)
ExecStart=%h/.local/bin/uv run --no-project --with bleak python scripts/toio_server.py
Restart=on-failure
RestartSec=10
Environment=PETIT_DATA_DIR=%h/petit_claude

[Install]
WantedBy=default.target
